{
  "name": "douyin-ts",
  "version": "0.0.2",
  "description": "抖音自动化 - 支持语义化筛选参数的搜索视频、搜索用户、点赞、收藏、关注",
  "type": "module",
  "bin": {
    "douyin": "./scripts/index.ts"
  },
  "scripts": {
    "start": "tsx scripts/index.ts",
    "help": "tsx scripts/index.ts --help",
    "login": "tsx scripts/index.ts login",
    "login:headless": "tsx scripts/index.ts login --headless",
    "user": "tsx scripts/index.ts user",
    "user:use": "tsx scripts/index.ts user --set-current",
    "search-video": "tsx scripts/index.ts search-video",
    "search-user": "tsx scripts/index.ts search-user",
    "like": "tsx scripts/index.ts like",
    "collect": "tsx scripts/index.ts collect",
    "follow": "tsx scripts/index.ts follow",
    "install:browser": "npx playwright install chromium",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint scripts --ext .ts",
    "lint:fix": "eslint scripts --ext .ts --fix",
    "format": "prettier --write scripts/**/*.ts",
    "format:check": "prettier --check scripts/**/*.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "dotenv": "^16.6.1",
    "playwright": "^1.40.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.57.1"
  },
  "keywords": [
    "douyin",
    "抖音",
    "playwright",
    "automation",
    "openclaw",
    "skill"
  ],
  "author": "lv-saharan",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  }
}
